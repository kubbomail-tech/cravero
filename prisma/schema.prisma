// Cravero Muebles - Sistema de Presupuestación
// Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATOR
}

enum QuoteStatus {
  DRAFT
  ISSUED
  APPROVED
  REJECTED
  EXPIRED
}

enum PriceUpdateScope {
  ALL
  CATEGORY
  PROVEEDOR
  CUSTOM
}

enum MaterialSection {
  CORTES
  CANTO
  HERRAJES
  ADICIONALES
}

enum EdgeSide {
  TOP
  BOTTOM
  LEFT
  RIGHT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(OPERATOR)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  quotes             Quote[]
  priceUpdateBatches PriceUpdateBatch[]
  auditLogs          AuditLog[]
  quotePdfs          QuotePdf[]

  @@map("users")
}

model Client {
  id           String   @id @default(cuid())
  fullName     String   @map("full_name")
  businessName String?  @map("business_name")
  phone        String?
  email        String?
  address      String?
  city         String?
  province     String?
  notes        String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  quotes Quote[]

  @@map("clients")
}

model FurnitureType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  quoteItems QuoteItem[]

  @@map("furniture_types")
}

model Proveedor {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  materials          Material[]
  priceUpdateBatches PriceUpdateBatch[]

  @@map("proveedores")
}

model MaterialCategory {
  id          String          @id @default(cuid())
  name        String          @unique
  description String?
  seccion     MaterialSection?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  materials          Material[]
  priceUpdateBatches PriceUpdateBatch[]

  @@map("material_categories")
}

model Unit {
  id        String   @id @default(cuid())
  code      String   @unique // M2, ML, UNIT, SET, PACK
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  materials Material[]

  @@map("units")
}

model Material {
  id           String   @id @default(cuid())
  name         String
  internalCode String?  @map("internal_code")
  categoryId   String   @map("category_id")
  proveedorId  String?  @map("proveedor_id")
  unitId       String   @map("unit_id")
  unitCost     Decimal  @default(0) @map("unit_cost") @db.Decimal(12, 2)
  stock        Decimal? @db.Decimal(12, 3)
  notes        String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  category               MaterialCategory         @relation(fields: [categoryId], references: [id])
  proveedor              Proveedor?               @relation(fields: [proveedorId], references: [id])
  unit                   Unit                     @relation(fields: [unitId], references: [id])
  priceUpdateBatchItems  PriceUpdateBatchItem[]
  quoteItemCuts          QuoteItemCut[]
  quoteItemEdgeBands     QuoteItemEdgeBand[]
  quoteItemAccessories   QuoteItemAccessory[]
  quoteItemAdditionals   QuoteItemAdditional[]

  @@map("materials")
}

model PriceUpdateBatch {
  id          String           @id @default(cuid())
  name        String
  percentage  Decimal          @db.Decimal(8, 4)
  scopeType   PriceUpdateScope @map("scope_type")
  categoryId  String?          @map("category_id")
  proveedorId String?          @map("proveedor_id")
  createdBy   String           @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at")

  category   MaterialCategory?      @relation(fields: [categoryId], references: [id])
  proveedor  Proveedor?             @relation(fields: [proveedorId], references: [id])
  creator    User                   @relation(fields: [createdBy], references: [id])
  items      PriceUpdateBatchItem[]

  @@map("price_update_batches")
}

model PriceUpdateBatchItem {
  id       String   @id @default(cuid())
  batchId  String   @map("batch_id")
  materialId String @map("material_id")
  oldCost  Decimal  @map("old_cost") @db.Decimal(12, 2)
  newCost  Decimal  @map("new_cost") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")

  batch    PriceUpdateBatch @relation(fields: [batchId], references: [id])
  material Material         @relation(fields: [materialId], references: [id])

  @@map("price_update_batch_items")
}

model Quote {
  id               String      @id @default(cuid())
  quoteNumber      String      @unique @map("quote_number")
  title            String?
  clientId         String      @map("client_id")
  status           QuoteStatus @default(DRAFT)
  issueDate        DateTime    @map("issue_date")
  expirationDate   DateTime?   @map("expiration_date")
  laborPercentage  Decimal     @default(30) @map("labor_percentage") @db.Decimal(8, 4)
  vatPercentage    Decimal     @default(21) @map("vat_percentage") @db.Decimal(8, 4)
  discountAmount   Decimal     @default(0) @map("discount_amount") @db.Decimal(12, 2)
  paymentTerms     String?     @map("payment_terms")
  notes            String?
  subtotalMaterials   Decimal   @default(0) @map("subtotal_materials") @db.Decimal(12, 2)
  subtotalLabor       Decimal   @default(0) @map("subtotal_labor") @db.Decimal(12, 2)
  subtotalAdditionals Decimal   @default(0) @map("subtotal_additionals") @db.Decimal(12, 2)
  subtotalBeforeTax   Decimal   @default(0) @map("subtotal_before_tax") @db.Decimal(12, 2)
  vatAmount           Decimal   @default(0) @map("vat_amount") @db.Decimal(12, 2)
  totalAmount         Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
  createdBy        String      @map("created_by")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  client    Client      @relation(fields: [clientId], references: [id])
  creator   User        @relation(fields: [createdBy], references: [id])
  items     QuoteItem[]
  pdfs      QuotePdf[]

  @@map("quotes")
}

model QuoteItem {
  id              String   @id @default(cuid())
  quoteId         String   @map("quote_id")
  furnitureTypeId String?  @map("furniture_type_id")
  description     String?
  quantity        Int      @default(1)
  notes           String?
  subtotalMaterials         Decimal @default(0) @map("subtotal_materials") @db.Decimal(12, 2)
  subtotalHardware          Decimal @default(0) @map("subtotal_hardware") @db.Decimal(12, 2)
  subtotalAdditionals       Decimal @default(0) @map("subtotal_additionals") @db.Decimal(12, 2)
  subtotalAdditionalsLabor  Decimal @default(0) @map("subtotal_additionals_labor") @db.Decimal(12, 2)
  subtotalLabor             Decimal @default(0) @map("subtotal_labor") @db.Decimal(12, 2)
  subtotalTotal             Decimal @default(0) @map("subtotal_total") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  quote         Quote                @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  furnitureType FurnitureType?       @relation(fields: [furnitureTypeId], references: [id])
  cuts          QuoteItemCut[]
  accessories   QuoteItemAccessory[]
  additionals   QuoteItemAdditional[]

  @@map("quote_items")
}

model QuoteItemCut {
  id                      String   @id @default(cuid())
  quoteItemId             String   @map("quote_item_id")
  materialId              String?  @map("material_id")
  materialNameSnapshot    String?  @map("material_name_snapshot")
  materialUnitCostSnapshot Decimal? @map("material_unit_cost_snapshot") @db.Decimal(12, 2)
  description             String?
  width                   Decimal  @db.Decimal(10, 2) // in mm
  height                  Decimal  @db.Decimal(10, 2) // in mm
  quantity                Int      @default(1)
  areaPerUnit             Decimal  @default(0) @map("area_per_unit") @db.Decimal(12, 6) // m2
  totalArea               Decimal  @default(0) @map("total_area") @db.Decimal(12, 6)   // m2
  notes                   String?
  subtotalCost            Decimal  @default(0) @map("subtotal_cost") @db.Decimal(12, 2)
  showInPdf               Boolean  @default(true) @map("show_in_pdf")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  quoteItem  QuoteItem           @relation(fields: [quoteItemId], references: [id], onDelete: Cascade)
  material   Material?           @relation(fields: [materialId], references: [id])
  edgeBands  QuoteItemEdgeBand[]

  @@map("quote_item_cuts")
}

model QuoteItemEdgeBand {
  id                      String   @id @default(cuid())
  quoteItemCutId          String   @map("quote_item_cut_id")
  materialId              String?  @map("material_id")
  materialNameSnapshot    String?  @map("material_name_snapshot")
  materialUnitCostSnapshot Decimal? @map("material_unit_cost_snapshot") @db.Decimal(12, 2)
  side                    EdgeSide
  length                  Decimal  @db.Decimal(10, 2) // mm
  quantity                Int      @default(1)
  totalLength             Decimal  @default(0) @map("total_length") @db.Decimal(12, 4) // m
  subtotalCost            Decimal  @default(0) @map("subtotal_cost") @db.Decimal(12, 2)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  quoteItemCut QuoteItemCut @relation(fields: [quoteItemCutId], references: [id], onDelete: Cascade)
  material     Material?    @relation(fields: [materialId], references: [id])

  @@map("quote_item_edge_bands")
}

model QuoteItemAccessory {
  id                      String   @id @default(cuid())
  quoteItemId             String   @map("quote_item_id")
  materialId              String?  @map("material_id")
  materialNameSnapshot    String?  @map("material_name_snapshot")
  materialUnitCostSnapshot Decimal? @map("material_unit_cost_snapshot") @db.Decimal(12, 2)
  description             String?
  quantity                Int      @default(1)
  subtotalCost            Decimal  @default(0) @map("subtotal_cost") @db.Decimal(12, 2)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  quoteItem QuoteItem @relation(fields: [quoteItemId], references: [id], onDelete: Cascade)
  material  Material? @relation(fields: [materialId], references: [id])

  @@map("quote_item_accessories")
}

model QuoteItemAdditional {
  id                       String   @id @default(cuid())
  quoteItemId              String   @map("quote_item_id")
  materialId               String?  @map("material_id")
  materialNameSnapshot     String?  @map("material_name_snapshot")
  materialUnitCostSnapshot Decimal? @map("material_unit_cost_snapshot") @db.Decimal(12, 2)
  description              String?
  quantity                 Int      @default(1)
  subtotalCost             Decimal  @default(0) @map("subtotal_cost") @db.Decimal(12, 2)
  showPrice                Boolean  @default(true) @map("show_price")
  applyLabor               Boolean  @default(false) @map("apply_labor")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  quoteItem QuoteItem @relation(fields: [quoteItemId], references: [id], onDelete: Cascade)
  material  Material? @relation(fields: [materialId], references: [id])

  @@map("quote_item_additionals")
}

model QuotePdf {
  id          String   @id @default(cuid())
  quoteId     String   @map("quote_id")
  fileUrl     String   @map("file_url")
  generatedAt DateTime @default(now()) @map("generated_at")
  generatedBy String   @map("generated_by")

  quote     Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  generator User  @relation(fields: [generatedBy], references: [id])

  @@map("quote_pdfs")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  action      String
  payloadJson Json?    @map("payload_json")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
